# Local development defaults. Copy to .env and replace values as needed.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_ORIGINS=

# Optional locally; when unset, the app uses db.sqlite3.
# For PostgreSQL, use: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=

# Country code first, digits only.
WHATSAPP_NUMBER=2349123323596

# Set automatically by Render; only set manually if needed.
# RENDER_EXTERNAL_HOSTNAME=
